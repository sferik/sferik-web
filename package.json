{
  "name": "sferik-web",
  "private": true,
  "description": "Erik Berlin's personal website and its API. No build step; `bun start` runs the server.",
  "scripts": {
    "start": "bun run build && node src/server.ts",
    "dev": "tsc -p tsconfig.client.json --watch --preserveWatchOutput & node --watch src/server.ts",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "build": "tsc -p tsconfig.client.json",
    "og": "node scripts/og.ts",
    "snapshot": "node scripts/snapshot.ts",
    "lighthouse": "bun run build && node scripts/lighthouse.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "bun run test:server && bun run test:browser",
    "test:server": "node --import ./tests/support/cloudflare.ts --test --experimental-test-coverage --test-coverage-include=src/server.ts --test-coverage-include=src/worker.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/server/server.test.ts tests/server/worker.test.ts",
    "test:browser": "playwright test",
    "coverage": "playwright test; open coverage/index.html"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "lighthouse": "^13.5.0",
    "monocart-coverage-reports": "^2.13.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.148.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "packageManager": "bun@1.3.0"
}
