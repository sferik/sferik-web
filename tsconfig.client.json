{
  // The browser code, as native ES modules: type-checked with this, and compiled to public/*.js as it is by
  // `bun run dev`. `bun run build` compiles it to the same files, minified, each still a module of its own.
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "outDir": "public",
    "rootDir": "src/client",
    "sourceMap": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/client/**/*.ts", "src/types.d.ts"]
}
